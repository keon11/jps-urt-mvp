{
  "name": "hospital-ur-ai-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch services/api/src/server.ts",
    "start": "tsx services/api/src/server.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test services/api/test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "test:browser": "playwright test",
    "infra": "docker compose up -d",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:audit": "tsx scripts/verify-audit.ts",
    "demo": "tsx scripts/prepare-demo.ts",
    "start:demo": "bash scripts/start-demo.sh",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "test:preview": "npm run build:preview && node scripts/verify-preview.mjs && playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@medplum/core": "5.2.6",
    "@medplum/fhirtypes": "5.2.6",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "cheerio": "1.1.2",
    "diff": "8.0.4",
    "express": "5.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "robots-parser": "2.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/diff": "7.0.2",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
