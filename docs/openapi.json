  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ur_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "enum": [
              "reviewer",
              "advisor",
              "admin"
            ]
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "SyntheticBundle": {
        "type": "object",
        "description": "Only the six exact shipped fictional transaction bundles are accepted; download from /fixtures/{id}.",
        "required": [
          "resourceType",
          "type",
          "identifier",
          "entry"
        ],
        "properties": {
          "resourceType": {
            "const": "Bundle"
          },
          "type": {
            "const": "transaction"
          },
          "identifier": {
            "type": "object"
          },
          "entry": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "initial",
              "continued-stay"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "Vitals": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spo2": {
            "type": "number",
            "minimum": 50,
            "maximum": 100
          },
          "systolic": {
            "type": "number",
            "minimum": 40,
            "maximum": 240
          },
          "expectedNights": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          }
        },
        "required": [
          "spo2",
          "systolic",
          "expectedNights"
        ]
      },
      "AuthorizationEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "payer-response",
              "notify",
              "simulate-expiry"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pending-information",
              "approved",
              "partial-approved",
              "denied"
            ]
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "action",
          "eventId"
        ]
      },
      "Escalation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "status-mismatch",
              "continued-stay",
              "documentation-gap",
              "authorization-risk",
              "clinical-uncertainty"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "type": "string",
            "enum": [
              "Inpatient",
              "Observation",
              "Request more information"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "evidence-supports-recommendation",
              "clinical-judgment-override",
              "additional-documentation-required"
            ]
          }
        },
        "required": [
          "disposition",
          "reason"
        ]
      }
    }
  }
}